   "source": [
    "import pandas as pd\n",
    "races = pd.read_csv(\"../data/raw/races.csv\" , na_values=r\"\\N\")\n",
    "print(races.shape)\n",
    "print(list(races.columns))\n",
    "\n",
    "#valeurs manquantes\n",
    "print(races.dtypes)\n",
    "print(races.isna().sum())\n",
    "print(races.isna().mean().round(3))\n",
    "print(races.loc[races[\"fp1_date\"].notna(), \"year\"].value_counts().sort_index())\n",
    "\n",
    "# A1. time : première année renseignée, puis part renseignée par saison\n",
    "print(races.loc[races[\"time\"].notna(), \"year\"].min())\n",
    "print(races[\"time\"].notna().groupby(races[\"year\"]).mean().round(2).loc[2014:])\n",
    "# A2. fp1_date présente mais fp1_time absente : quelles années ?\n",
    "print(races.loc[races[\"fp1_date\"].notna() & races[\"fp1_time\"].isna(), \"year\"].value_counts().sort_index())\n",
    "\n",
    "# A3. Les week-ends sprint\n",
    "print(races.loc[races[\"sprint_date\"].notna(), [\"year\", \"round\", \"date\"]].sort_values([\"year\", \"round\"]))\n",
    "m = races[\"fp1_date\"].notna() & races[\"fp3_date\"].isna()\n",
    "print(m.sum(), (m & races[\"sprint_date\"].notna()).sum())\n",
    "\n",
    "#où commence l'enregistrement des fp\n",
    "print(races.loc[races[\"time\"].isna(), \"year\"].max())   # attendu : 2004\n",
    "print((races[\"year\"] < 2005).sum())                     # attendu : 731\n",
    "cols = [c for c in races.columns if c.startswith((\"fp\", \"quali\", \"sprint\"))]\n",
    "print({c: int(races.loc[races[c].notna(), \"year\"].min()) for c in cols})\n",
    "\n",
    "#Combien de sprint? \n",
    "sprint = races[\"sprint_date\"].notna()\n",
    "print(sprint.sum())                                  # attendu : 30\n",
    "print(sprint.groupby(races[\"year\"]).sum().loc[2021:])  # attendu : 3, 3, 6, 6, 6, 6\n",
    "print(sprint[races[\"year\"] < 2021].sum())            # attendu : 0\n"
   ]
  },
