    "# 1. Distributions numériques\n",
    "print(circuits[[\"lat\", \"lng\", \"alt\"]].describe())\n",
    "\n",
    "# 2. Extrêmes d'altitude\n",
    "print(circuits.sort_values(\"alt\")[[\"name\", \"country\", \"alt\"]].iloc[[0, 1, 2, -3, -2, -1]])\n",
    "\n",
    "# 3. Altitudes nulles ou négatives (le point resté en attente)\n",
    "print((circuits[\"alt\"] <= 0).sum())\n",
    "print(circuits.loc[circuits[\"alt\"] <= 0, [\"name\", \"country\", \"alt\"]])\n",
    "\n",
    "# 4. Coordonnées impossibles\n",
    "print(((circuits[\"lat\"].abs() > 90) | (circuits[\"lng\"].abs() > 180)).sum())   # doit valoir 0\n",
    "\n",
    "# 5. Textes : espaces en trop, entités HTML, doubles espaces\n",
    "for col in [\"circuitRef\", \"name\", \"location\", \"country\"]:\n",
    "    print(\n",
    "        col,\n",
    "        \"| espaces :\", (circuits[col] != circuits[col].str.strip()).sum(),\n",
    "        \"| entités HTML :\", circuits[col].str.contains(r\"&\\w+;\").sum(),\n",
    "        \"| doubles esp. :\", circuits[col].str.contains(\"  \").sum(),\n",
    "    )\n",
    "\n",
    "# 6. Format de circuitRef (minuscules, chiffres, underscores)\n",
    "print(circuits[\"circuitRef\"].str.match(r\"^[a-z0-9_]+$\").all())\n",
    "\n",
    "# 7. Caractères non standard (accents, tirets : légitimes ou parasites ?)\n",
    "for col in [\"name\", \"location\", \"country\"]:\n",
    "    print(col, circuits.loc[circuits[col].str.contains(r\"[^A-Za-z0-9 ]\"), col].unique())\n",
    "\n",
    "# 8. Variantes d'écriture des pays\n",
    "print(circuits[\"country\"].value_counts())\n",
    "\n",
    "print(circuits.loc[circuits[\"name\"].str.contains(\"Nelson Piquet\"), [\"circuitId\", \"circuitRef\", \"location\", \"country\", \"lat\", \"lng\", \"alt\"]])\n",
    "\n",
    "print(circuits.loc[circuits[\"country\"] == \"United States\", [\"circuitId\", \"name\", \"location\", \"country\"]])\n",
